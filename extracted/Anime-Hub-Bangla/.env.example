# Copy to apps/api/.env. Never commit real values.
PORT=4000
NODE_ENV=development
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DB?sslmode=require
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET
WEB_ORIGIN=http://localhost:5173

# Cloudflare R2 (server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Video provider: cloudflare-stream | bunny | manual
VIDEO_PROVIDER=manual
CLOUDFLARE_STREAM_ACCOUNT_ID=
CLOUDFLARE_STREAM_API_TOKEN=
BUNNY_LIBRARY_ID=
BUNNY_API_KEY=

# Ads and payments are optional; configure only after provider approval.
ADSTERRA_API_KEY=
SSLCOMMERZ_STORE_ID=
SSLCOMMERZ_STORE_PASSWORD=
BKASH_APP_KEY=
BKASH_APP_SECRET=
NAGAD_MERCHANT_ID=

# One-time first Super Admin bootstrap (use in apps/api/.env only, then remove password)
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
SUPER_ADMIN_NAME=Super Admin
